# .dev.vars — secretos locales (NO COMMIT). Copia a .dev.vars y rellena.
# Producción Cloudflare: wrangler secret put <NAME>  (desde carpeta mcp/)
#
# Alineado con secretos CF del Worker alejotaller-mcp:
#   APPWRITE_ENDPOINT
#   APPWRITE_PROJECT_ID
#   APPWRITE_API_KEY
#   APPWRITE_DATABASE_ID

# ─── Appwrite (requeridos) ─────────────────────────────────────────────────
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your-project-id-here
APPWRITE_API_KEY=your-server-api-key-here
APPWRITE_DATABASE_ID=your-database-id-here

# ─── Auth Fase 1 (header X-Customer-Id; JWT en fase posterior) ─────────────
# Opcional en local. No sustituye los cuatro secretos Appwrite de arriba.
MCP_AUTH_SECRET=change-me-in-production

# ─── Runtime ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
